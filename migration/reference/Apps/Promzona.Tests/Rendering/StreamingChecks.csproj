<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net11.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="StreamingChecks.cs" />
    <Compile Include="../../Promzona/Game/CityVisibility.cs" Link="CityVisibility.cs" />
    <Compile Include="../../Promzona/Game/CityDistrictOcclusion.cs" Link="CityDistrictOcclusion.cs" />
    <Compile Include="../../Promzona/Game/CityMeshStaging.cs" Link="CityMeshStaging.cs" />
    <Reference Include="Promzona"><HintPath>$(GameDir)/Promzona.dll</HintPath></Reference>
    <Reference Include="MakarovPhysics.Renderer"><HintPath>$(GameDir)/MakarovPhysics.Renderer.dll</HintPath></Reference>
  </ItemGroup>
</Project>
