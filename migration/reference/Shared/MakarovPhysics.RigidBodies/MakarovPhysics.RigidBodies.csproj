<Project Sdk="Microsoft.NET.Sdk">

  <!-- Rigid-body engine ported from Wrecksmith (MakarovPhysicsSandbox).
       Dependencies: System.Numerics only. Solver: sequential impulse,
       warm starting, split impulse, spatial hash, sleeping, joints,
       force fields, water (Archimedes), destruction. -->
  <PropertyGroup>
    <!-- NEUTRAL, not -windows: a solver, no window.
         A target framework is a claim about what the code needs, and this one
         needed nothing from Windows. Saying otherwise kept the library out of
         every project that is not a Windows project - including a test runner
         that could execute these groups on Linux and on the Mac, which is the
         reason this changed (09.08). -->
    <TargetFramework>net11.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- World2D.cs belongs in the SIBLING project, RigidBodies2D (02.08) -
         the two folder names differ by two characters and a drag-and-drop
         or a partial delta unzip can land the file here instead. If it
         does, the SDK glob pulls it in, Body2D/RevoluteJoint2D resolve to
         nothing (this project has no reference to RigidBodies2D - by
         design, see Docs/libs/RigidBodies.md), and the whole project fails
         with CS0246 x11. Keep the build correct even before anyone notices
         and moves the file back. -->
    <Compile Remove="World2D.cs" />
  </ItemGroup>

</Project>
