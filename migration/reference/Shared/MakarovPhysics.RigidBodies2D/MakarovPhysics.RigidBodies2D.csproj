<Project Sdk="Microsoft.NET.Sdk">

  <!-- 2D rigid-body engine extracted from Module.Sandbox2D so any project can
       take it standalone. Dependencies: BCL only. Solver: Box2D-lite style
       sequential impulses with warm starting, SAT + reference-face clipping,
       Coulomb friction, Baumgarte bias, spatial-hash broadphase, sleeping,
       revolute joints with motors, capped grab spring. -->
  <PropertyGroup>
    <!-- NEUTRAL, not -windows: the same, flat.
         A target framework is a claim about what the code needs, and this one
         needed nothing from Windows. Saying otherwise kept the library out of
         every project that is not a Windows project - including a test runner
         that could execute these groups on Linux and on the Mac, which is the
         reason this changed (09.08). -->
    <TargetFramework>net11.0</TargetFramework>
  </PropertyGroup>

</Project>
