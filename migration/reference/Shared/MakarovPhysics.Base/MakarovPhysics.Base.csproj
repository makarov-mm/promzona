<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- NEUTRAL, not -windows: the module contract; UserRegistry is the one Windows corner and says so.
         A target framework is a claim about what the code needs, and this one
         needed nothing from Windows. Saying otherwise kept the library out of
         every project that is not a Windows project - including a test runner
         that could execute these groups on Linux and on the Mac, which is the
         reason this changed (09.08). -->
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Stale file from older versions (SharedData was renamed to AppPaths).
       Excluded so an unpacked-over working copy still builds. -->

</Project>
