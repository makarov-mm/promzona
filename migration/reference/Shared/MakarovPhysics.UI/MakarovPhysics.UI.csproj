<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MakarovPhysics.Base\MakarovPhysics.Base.csproj" />
    <ProjectReference Include="..\MakarovPhysics.Renderer\MakarovPhysics.Renderer.csproj" />
    <!-- ComputeBackendSelector asks the runtimes what they can offer, so the
         UI needs the compute layer. Compute references nothing, so this adds
         an edge and no cycle (22.08). -->
    <ProjectReference Include="..\MakarovPhysics.Compute\MakarovPhysics.Compute.csproj" />
    <ProjectReference Include="..\MakarovPhysics.Numerics\MakarovPhysics.Numerics.csproj" />
  </ItemGroup>

</Project>
