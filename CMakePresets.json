{
  "version": 6,
  "cmakeMinimumRequired": { "major": 4, "minor": 2, "patch": 0 },
  "configurePresets": [
    {
      "name": "vs2026",
      "displayName": "Visual Studio 2026 — x64",
      "description": "Native C++23 game, libraries and tests; Debug and Release in one solution.",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2026",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs2026-debug",
      "configurePreset": "vs2026",
      "configuration": "Debug",
      "jobs": 1,
      "nativeToolOptions": [ "/nr:false" ]
    },
    {
      "name": "vs2026-release",
      "configurePreset": "vs2026",
      "configuration": "Release",
      "jobs": 1,
      "nativeToolOptions": [ "/nr:false" ]
    }
  ],
  "testPresets": [
    {
      "name": "vs2026-debug",
      "configurePreset": "vs2026",
      "configuration": "Debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "vs2026-release",
      "configurePreset": "vs2026",
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
